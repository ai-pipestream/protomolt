+    "${SCRIPT_DIR}/protobuf/cmake/dependencies.cmake"
+
 rm "${SCRIPT_DIR}"/protobuf/src/google/protobuf/compiler/subprocess.* "${SCRIPT_DIR}"/protobuf/src/google/protobuf/compiler/command_line_interface.*
 sed -i '/src\/google\/protobuf\/compiler\/subprocess\./d' "${SCRIPT_DIR}"/protobuf/src/file_lists.cmake
 sed -i '/src\/google\/protobuf\/compiler\/command_line_interface\./d' "${SCRIPT_DIR}"/protobuf/src/file_lists.cmake
diff --git a/buildtools-v4/Dockerfile b/buildtools-v4/Dockerfile
index 9268af1..c222d1b 100644
--- a/buildtools-v4/Dockerfile
+++ b/buildtools-v4/Dockerfile
@@ -1,7 +1,29 @@
-FROM ubuntu:24.04
-
-# Install dependencies
-RUN apt-get update && apt-get install -y git patch curl wget cmake && rm -rf /var/lib/apt/lists/*
+# The build runs on linux/amd64 only. The Ubuntu snapshot service serves
+# the amd64 archive but not ubuntu-ports, so an arm64 image could not pin
+# its packages; an arm64 host runs this amd64 image under emulation. The
+# WASM output does not depend on the build architecture.
+FROM --platform=linux/amd64 ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
+
+# Install dependencies from a fixed Ubuntu archive snapshot so package
+# versions cannot drift between rebuilds (see
+# core/codegen/provenance/README.md in the protomolt repository).
+# The snapshot host redirects to HTTPS and the base image ships no CA
+# bundle, so TLS peer verification is off for that one host only; package
+# integrity and origin authentication come from apt's signed Release
+# files, as with the plain-HTTP archive this recipe used before. The
+# source rewrite is checked, so an image whose sources do not match fails
+# here instead of installing unpinned packages.
+RUN sed -i \
+      -e 's|http://archive.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      -e 's|http://security.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      /etc/apt/sources.list.d/ubuntu.sources \
+ && grep -q 'snapshot.ubuntu.com/ubuntu/20261024T120000Z/' /etc/apt/sources.list.d/ubuntu.sources \
+ && ! grep -q -e 'archive.ubuntu.com' -e 'security.ubuntu.com' -e 'ports.ubuntu.com' \
+      /etc/apt/sources.list.d/ubuntu.sources \
+ && printf 'Acquire::https::snapshot.ubuntu.com::Verify-Peer "false";\nAcquire::https::snapshot.ubuntu.com::Verify-Host "false";\n' \
+      > /etc/apt/apt.conf.d/99snapshot-tls \
+ && apt-get -o Acquire::Check-Valid-Until=false update \
+ && apt-get install -y git patch curl wget cmake && rm -rf /var/lib/apt/lists/*
 
 WORKDIR /workspace
 
