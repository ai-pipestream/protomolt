diff --git a/buildtools-common/prepare_build.sh b/buildtools-common/prepare_build.sh
index 6a740a6..58a7302 100755
--- a/buildtools-common/prepare_build.sh
+++ b/buildtools-common/prepare_build.sh
@@ -13,7 +13,21 @@ case "${ARCH,,}" in
     *) echo "ERROR: unsupported architecture ${ARCH}" >&2; exit 1 ;;
 esac
 
-WASI_SDK_PATH=${SCRIPT_DIR}/tools/wasi-sdk-25.0-${WASI_SDK_ARCH}
+WASI_SDK_PATH=${SCRIPT_DIR}/tools/wasi-sdk-34.0-${WASI_SDK_ARCH}
+
+# WASI SDK 34 builds its threaded sysroot only for wasm32-wasip1-threads:
+# wasi-sdk PR 637 removed the deprecated wasm32-wasi-threads target from
+# WASI_SDK_TARGETS, but share/cmake/wasi-sdk-pthread.cmake still sets
+# `triple wasm32-wasi-threads`, so clang finds no crt1.o or libc for it.
+# Derive a toolchain file that differs from the shipped one in that line
+# only, next to it so its relative WASI_SDK_PREFIX still resolves.
+PTHREAD_TOOLCHAIN="${WASI_SDK_PATH}/share/cmake/wasi-sdk-pthread.cmake"
+P1_THREADS_TOOLCHAIN="${WASI_SDK_PATH}/share/cmake/wasi-sdk-p1-threads.cmake"
+test -d "${WASI_SDK_PATH}/share/wasi-sysroot/lib/wasm32-wasip1-threads"
+sed 's/^set(triple wasm32-wasi-threads)$/set(triple wasm32-wasip1-threads)/' \
+    "${PTHREAD_TOOLCHAIN}" > "${P1_THREADS_TOOLCHAIN}"
+test "$(diff "${PTHREAD_TOOLCHAIN}" "${P1_THREADS_TOOLCHAIN}" | grep -c '^[<>]')" = 2
+grep -qx 'set(triple wasm32-wasip1-threads)' "${P1_THREADS_TOOLCHAIN}"
 
 # Detect protobuf version to set appropriate API defines
 # Check if protobuf-version.txt exists (it should be in the workspace root)
@@ -36,7 +50,12 @@ fi
 
 CFLAGS="-D_WASI_EMULATED_MMAN -D_WASI_EMULATED_PROCESS_CLOCKS -D_WASI_EMULATED_SIGNAL -DABSL_HAVE_MMAP -DABSL_FORCE_THREAD_IDENTITY_MODE=1 -DWASM_WAMR -isystem ${SCRIPT_DIR}/protobuf/wasm-stubs"
 CXXFLAGS="$CFLAGS -fno-exceptions $PROTOBUF_API_DEFINE"
-LDFLAGS="-lwasi-emulated-process-clocks -lwasi-emulated-mman -lwasi-emulated-signal -Wl,--max-memory=4294967296 -Wl,--global-base=1024"
+# LLVM 22 and later (WASI SDK 34 ships LLVM 23) default wasm-ld to
+# --stack-first, which places the 64 KiB stack below static data and
+# rejects a --global-base smaller than the stack. The former
+# --global-base=1024 only restated the old non-stack-first default, so it
+# is dropped and the stack-first layout is kept.
+LDFLAGS="-lwasi-emulated-process-clocks -lwasi-emulated-mman -lwasi-emulated-signal -Wl,--max-memory=4294967296"
 
 mkdir -p "$SCRIPT_DIR/build"
 
@@ -44,7 +63,7 @@ mkdir -p "$SCRIPT_DIR/build"
     cd "$SCRIPT_DIR/build"
 
     cmake \
-        -DCMAKE_TOOLCHAIN_FILE="$WASI_SDK_PATH/share/cmake/wasi-sdk-pthread.cmake" \
+        -DCMAKE_TOOLCHAIN_FILE="${P1_THREADS_TOOLCHAIN}" \
         -DCMAKE_BUILD_TYPE=Release \
         -DCMAKE_C_FLAGS="$CFLAGS" \
         -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
diff --git a/buildtools-v4/Dockerfile b/buildtools-v4/Dockerfile
index 9268af1..1a335cb 100644
--- a/buildtools-v4/Dockerfile
+++ b/buildtools-v4/Dockerfile
@@ -1,7 +1,41 @@
-FROM ubuntu:24.04
+# The build runs on linux/amd64 only. The Ubuntu snapshot service serves
+# the amd64 archive but not ubuntu-ports, so an arm64 image could not pin
+# its packages; an arm64 host runs this amd64 image under emulation. The
+# WASM output does not depend on the build architecture.
+FROM --platform=linux/amd64 ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
 
-# Install dependencies
-RUN apt-get update && apt-get install -y git patch curl wget cmake && rm -rf /var/lib/apt/lists/*
+# Install dependencies from a fixed Ubuntu archive snapshot so package
+# versions cannot drift between rebuilds (see
+# core/codegen/provenance/README.md in the protomolt repository).
+# The minimal base image ships no CA bundle, so BuildKit fetches the
+# exact openssl and ca-certificates .debs from that same snapshot over
+# host-verified HTTPS and checks their SHA-256 digests before dpkg
+# populates /etc/ssl/certs/ca-certificates.crt. With the CA bundle in
+# place, apt talks to https://snapshot.ubuntu.com directly with its
+# default TLS peer/host verification and Release validity checks intact,
+# and --error-on=any refuses any index fetch failure.
+ADD --checksum=sha256:675b84971ffd4467707008c25ef7520f90ea7c23ef27b7a76b0dccf1d7c4dc3f \
+    https://snapshot.ubuntu.com/ubuntu/20261024T120000Z/pool/main/o/openssl/openssl_3.0.13-0ubuntu3.16_amd64.deb \
+    /tmp/bootstrap-debs/openssl.deb
+ADD --checksum=sha256:8a0a754aaafed72cc8efb8c1731808133284a84fbfc76a4fcc73fce9e01b4187 \
+    https://snapshot.ubuntu.com/ubuntu/20261024T120000Z/pool/main/c/ca-certificates/ca-certificates_20260816ubuntu0.24.04.1_all.deb \
+    /tmp/bootstrap-debs/ca-certificates.deb
+
+RUN DEBIAN_FRONTEND=noninteractive dpkg -i \
+      /tmp/bootstrap-debs/openssl.deb \
+      /tmp/bootstrap-debs/ca-certificates.deb \
+ && rm -rf /tmp/bootstrap-debs \
+ && test -s /etc/ssl/certs/ca-certificates.crt \
+ && sed -i \
+      -e 's|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      -e 's|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      /etc/apt/sources.list.d/ubuntu.sources \
+ && grep -q '^URIs: https://snapshot.ubuntu.com/ubuntu/20261024T120000Z/$' /etc/apt/sources.list.d/ubuntu.sources \
+ && ! grep -q -e 'archive.ubuntu.com' -e 'security.ubuntu.com' -e 'ports.ubuntu.com' -e '^URIs:.*http://' \
+      /etc/apt/sources.list.d/ubuntu.sources \
+ && apt-get --error-on=any update \
+ && DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates git patch curl wget cmake \
+ && rm -rf /var/lib/apt/lists/*
 
 WORKDIR /workspace
 
