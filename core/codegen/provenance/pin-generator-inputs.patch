diff --git a/buildtools-common/get_grpcjava.sh b/buildtools-common/get_grpcjava.sh
index c986973..2707207 100755
--- a/buildtools-common/get_grpcjava.sh
+++ b/buildtools-common/get_grpcjava.sh
@@ -3,10 +3,14 @@ set -euxo pipefail
 
 SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
 
-mkdir -p "${SCRIPT_DIR}/grpcjava"
+rm -rf "${SCRIPT_DIR}/grpcjava"
 
 GRPC_VERSION=$(awk '{$1=$1};1' < "${SCRIPT_DIR}/grpcjava-version.txt")
-curl --fail -L "https://github.com/grpc/grpc-java/archive/refs/tags/${GRPC_VERSION}.tar.gz" \
-    | tar -xz --strip-components 1 -C "${SCRIPT_DIR}/grpcjava"
+git -c advice.detachedHead=false clone --depth 1 --branch "${GRPC_VERSION}" \
+    https://github.com/grpc/grpc-java.git "${SCRIPT_DIR}/grpcjava"
+# The tag must still resolve to the exact reviewed commit (v1.79.0). A git
+# commit is stable where GitHub's generated source archives are not.
+test "$(git -C "${SCRIPT_DIR}/grpcjava" rev-parse HEAD)" = "381593f39e37b530177faad3c6035cfce4536ec7" \
+    || { echo "ERROR: grpc-java ${GRPC_VERSION} is not the pinned commit" >&2; exit 1; }
 
 cp -R "${SCRIPT_DIR}/grpcjava/compiler/src/java_plugin/cpp" "${SCRIPT_DIR}/protobuf/src/grpcjava"
\ No newline at end of file
