diff --git a/buildtools-common/patch_protobuf.sh b/buildtools-common/patch_protobuf.sh
index 824dcb3..0f2086e 100755
--- a/buildtools-common/patch_protobuf.sh
+++ b/buildtools-common/patch_protobuf.sh
@@ -19,6 +19,13 @@ set_target_properties(protoc-wrapper PROPERTIES VERSION ${protobuf_VERSION})
 add_dependencies(plugins protoc-wrapper)
 EOF
 
+# Pin the CMake FetchContent abseil input to the exact commit of its
+# 20250512.1 tag instead of the movable tag name.
+sed -i 's/set(abseil-cpp-version "20250512.1")/set(abseil-cpp-version "76bb24329e8bf5f39704eb10d21b9a80befa7c81")/' \
+    "${SCRIPT_DIR}/protobuf/cmake/dependencies.cmake"
+grep -q 'set(abseil-cpp-version "76bb24329e8bf5f39704eb10d21b9a80befa7c81")' \
+    "${SCRIPT_DIR}/protobuf/cmake/dependencies.cmake"
+
 rm "${SCRIPT_DIR}"/protobuf/src/google/protobuf/compiler/subprocess.* "${SCRIPT_DIR}"/protobuf/src/google/protobuf/compiler/command_line_interface.*
 sed -i '/src\/google\/protobuf\/compiler\/subprocess\./d' "${SCRIPT_DIR}"/protobuf/src/file_lists.cmake
 sed -i '/src\/google\/protobuf\/compiler\/command_line_interface\./d' "${SCRIPT_DIR}"/protobuf/src/file_lists.cmake
diff --git a/buildtools-v4/Dockerfile b/buildtools-v4/Dockerfile
index 9268af1..80d6654 100644
--- a/buildtools-v4/Dockerfile
+++ b/buildtools-v4/Dockerfile
@@ -1,7 +1,20 @@
-FROM ubuntu:24.04
-
-# Install dependencies
-RUN apt-get update && apt-get install -y git patch curl wget cmake && rm -rf /var/lib/apt/lists/*
+FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
+
+# Install dependencies from a fixed Ubuntu archive snapshot so package
+# versions cannot drift between rebuilds (pinned by protomolt #828;
+# see core/codegen/provenance/README.md in the protomolt repository).
+# The snapshot host redirects to HTTPS and the base image ships no CA
+# bundle, so TLS peer verification is off for apt; package integrity and
+# origin authentication come from apt's signed Release files, exactly as
+# with the plain-HTTP archive this recipe used before.
+RUN sed -i \
+      -e 's|http://archive.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      -e 's|http://security.ubuntu.com/ubuntu/|http://snapshot.ubuntu.com/ubuntu/20261024T120000Z/|' \
+      /etc/apt/sources.list.d/ubuntu.sources \
+ && printf 'Acquire::https::Verify-Peer "false";\nAcquire::https::Verify-Host "false";\n' \
+      > /etc/apt/apt.conf.d/99snapshot-tls \
+ && apt-get -o Acquire::Check-Valid-Until=false update \
+ && apt-get install -y git patch curl wget cmake && rm -rf /var/lib/apt/lists/*
 
 WORKDIR /workspace
 
