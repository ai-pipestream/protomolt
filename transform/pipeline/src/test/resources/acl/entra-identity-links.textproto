# proto-file: ai/protomolt/proto/grpc/workflow/v1/grpc_workflow.proto
# proto-message: ai.protomolt.proto.grpc.workflow.v1.TypedEdge
#
# Maps one Entra user grpc-microsoft reads (ai.pipestream.microsoft.v1.GraphUser,
# source `user`) into an identity link for caller expansion: the user principal
# name links to the user's email address, its mail or, when it has none, the
# user principal name itself. A source that links its accounts from `email`
# joins on that address.
sources: "user"
produce_type: "ai.protomolt.proto.repo.v1.IdentityLink"
cel_rules {
  filter: "user.user_principal_name != ''"
  selector: "ai.protomolt.proto.repo.v1.Principal{identity_type: 'user-principal-name', identity: user.user_principal_name}"
  target: "from"
}
cel_rules {
  filter: "user.user_principal_name != ''"
  selector: "ai.protomolt.proto.repo.v1.Principal{identity_type: 'email', identity: user.mail != '' ? user.mail : user.user_principal_name}"
  target: "to"
}
