# proto-file: ai/protomolt/proto/grpc/workflow/v1/grpc_workflow.proto
# proto-message: ai.protomolt.proto.grpc.workflow.v1.TypedEdge
#
# Maps the site collection administrators grpc-microsoft Sync emits for a site
# (ai.pipestream.microsoft.v1.SiteAdmins, source `admins`) into identity links:
# each user (by user principal name, or email when it has none) links to
# `sharepoint-site-admin:<site id>`. A list that is not COMPLETE maps to no link.
sources: "admins"
produce_type: "ai.protomolt.proto.repo.v1.IdentityLinks"
cel_rules {
  filter: "admins.completeness == ai.pipestream.sync.v1.AclCompleteness.ACL_COMPLETENESS_COMPLETE"
  selector: "admins.admins.filter(m, m.principal_type == ai.pipestream.microsoft.v1.SitePrincipalType.SITE_PRINCIPAL_TYPE_USER && (m.user_principal_name != '' || m.email != '')).map(m, ai.protomolt.proto.repo.v1.IdentityLink{from: ai.protomolt.proto.repo.v1.Principal{identity_type: m.user_principal_name != '' ? 'user-principal-name' : 'email', identity: m.user_principal_name != '' ? m.user_principal_name : m.email}, to: ai.protomolt.proto.repo.v1.Principal{identity_type: 'sharepoint-site-admin', identity: admins.site_id}})"
  target: "links"
}
