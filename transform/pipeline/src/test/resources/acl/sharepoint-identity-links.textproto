# proto-file: ai/protomolt/proto/grpc/workflow/v1/grpc_workflow.proto
# proto-message: ai.protomolt.proto.grpc.workflow.v1.TypedEdge
#
# Maps one SharePoint group with its members (ai.pipestream.microsoft.v1.SiteGroupMembers,
# source `group`) into identity links for caller expansion: each user member
# (by user principal name, or email when it has none) and each directory group
# member with an object id (`entra-group`) links to `sharepoint-group`
# `<site id>/<group id>`, and each user member SharePoint marks as a site
# collection administrator links to `sharepoint-site-admin:<site id>`. A
# membership that is not COMPLETE maps to no link.
sources: "group"
produce_type: "ai.protomolt.proto.repo.v1.IdentityLinks"
cel_rules {
  filter: "group.completeness == ai.pipestream.sync.v1.AclCompleteness.ACL_COMPLETENESS_COMPLETE"
  selector: "group.members.filter(m, m.principal_type == ai.pipestream.microsoft.v1.SitePrincipalType.SITE_PRINCIPAL_TYPE_USER && (m.user_principal_name != '' || m.email != '')).map(m, ai.protomolt.proto.repo.v1.IdentityLink{from: ai.protomolt.proto.repo.v1.Principal{identity_type: m.user_principal_name != '' ? 'user-principal-name' : 'email', identity: m.user_principal_name != '' ? m.user_principal_name : m.email}, to: ai.protomolt.proto.repo.v1.Principal{identity_type: 'sharepoint-group', identity: group.site_id + '/' + string(group.group.id)}}) + group.members.filter(m, m.principal_type == ai.pipestream.microsoft.v1.SitePrincipalType.SITE_PRINCIPAL_TYPE_SECURITY_GROUP && m.directory_object_id != '').map(m, ai.protomolt.proto.repo.v1.IdentityLink{from: ai.protomolt.proto.repo.v1.Principal{identity_type: 'entra-group', identity: m.directory_object_id}, to: ai.protomolt.proto.repo.v1.Principal{identity_type: 'sharepoint-group', identity: group.site_id + '/' + string(group.group.id)}}) + group.members.filter(m, m.site_admin && m.principal_type == ai.pipestream.microsoft.v1.SitePrincipalType.SITE_PRINCIPAL_TYPE_USER && (m.user_principal_name != '' || m.email != '')).map(m, ai.protomolt.proto.repo.v1.IdentityLink{from: ai.protomolt.proto.repo.v1.Principal{identity_type: m.user_principal_name != '' ? 'user-principal-name' : 'email', identity: m.user_principal_name != '' ? m.user_principal_name : m.email}, to: ai.protomolt.proto.repo.v1.Principal{identity_type: 'sharepoint-site-admin', identity: group.site_id}})"
  target: "links"
}
