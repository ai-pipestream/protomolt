# syntax=docker/dockerfile:1.26
# ARM64-only DJL Serving runtime for JetPack 7.2. The NVIDIA 26.05 TensorRT
# image matches Nano1's CUDA 13.2 and TensorRT 10.16 software line.
FROM deepjavalibrary/djl-serving:0.36.0-aarch64@sha256:a3fc7ef607a2f0f0c559367cafcec3fea555735fcecfe99f43ad2213188f67c4 AS djl

FROM nvcr.io/nvidia/tensorrt:26.05-py3@sha256:c8b988f569903dd76f316d0ced022cf9668b788161264123f9d18657061d3e42

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl \
        openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=djl /usr/local/djl-serving-0.36.0 /usr/local/djl-serving-0.36.0
RUN ln -s /usr/local/djl-serving-0.36.0/bin/serving /usr/local/bin/djl-serving

COPY config.properties /opt/djl/conf/config.properties
COPY models /opt/ml/models
COPY start-djl.sh /opt/protomolt/start-djl.sh

RUN chmod 755 /opt/protomolt/start-djl.sh \
    && useradd --create-home --home-dir /home/djl --shell /usr/sbin/nologin djl \
    && install -d -o djl -g djl /opt/djl/logs /tmp/.djl.ai

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64 \
    JAVA_OPTS="-Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError -Dai.djl.default_engine=Python" \
    MODEL_SERVER_HOME=/opt/djl \
    DJL_CACHE_DIR=/tmp/.djl.ai \
    PYTHON_EXECUTABLE=/usr/bin/python3

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=4 \
  CMD curl --fail --silent http://127.0.0.1:8080/ping >/dev/null || exit 1

USER djl
WORKDIR /opt/djl

# Keep NVIDIA's entrypoint so it prepares the CUDA container environment before
# the strict ProtoMolt GPU gate runs.
ENTRYPOINT ["/opt/nvidia/nvidia_entrypoint.sh", "/opt/protomolt/start-djl.sh"]
CMD ["-m", "cuda-probe::Python=file:///opt/ml/models/cuda-probe"]
