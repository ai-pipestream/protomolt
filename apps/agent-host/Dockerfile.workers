# syntax=docker/dockerfile:1.27
# Language-specific coding workers. Build the agent-host distribution first:
#
#   ./gradlew :protomolt-agent-host:installDist
#   docker build --target java -f apps/agent-host/Dockerfile.workers \
#     -t protomolt-worker-java:local apps/agent-host
#
# Every target carries the Java agent host, its JRE, and the common protobuf and
# gRPC toolchain. The language targets add compilers and build systems without
# giving the container access to the host Docker daemon.

ARG BASE_IMAGE=ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
ARG JRE_IMAGE=eclipse-temurin:25-jre-noble@sha256:b573af9e331196fbc42e246da4df24df9b6c556c73e7efddfde0511f1c9508c5
ARG NODE_IMAGE=node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
ARG BUN_IMAGE=oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
ARG BUF_IMAGE=bufbuild/buf:1.73.0@sha256:75d8f756f0919dcded71e67968a91adfe55fe4dd62c4900c57bbfcd7fe625608
ARG GRPCURL_IMAGE=fullstorydev/grpcurl:v1.9.3-alpine@sha256:4614424ed58e9b9837c48b6b8eadb9ef40491d5af3499bcc8b378e9c64a9e4a9
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc
ARG DOCKER_CLI_IMAGE=docker:29.8.1-cli@sha256:018edbc908e08fcc9dbf029c812c34251e9b4719e6f71ca0e5eae2a987d014ca

FROM ${NODE_IMAGE} AS node
FROM ${BUN_IMAGE} AS bun
FROM ${BUF_IMAGE} AS buf
FROM ${GRPCURL_IMAGE} AS grpcurl
FROM ${UV_IMAGE} AS uv
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${JRE_IMAGE} AS jre

FROM ${BASE_IMAGE} AS common

ARG CODEX_VERSION=0.147.0
ARG WORKER_UID=10001
ARG WORKER_GID=10001

COPY --from=node /usr/local /usr/local
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=buf /usr/local/bin/buf /usr/local/bin/buf
COPY --from=grpcurl /bin/grpcurl /usr/local/bin/grpcurl
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash-completion \
        ca-certificates \
        curl \
        file \
        git \
        git-lfs \
        jq \
        less \
        make \
        openssh-client \
        patch \
        procps \
        protobuf-compiler \
        python3 \
        ripgrep \
        shellcheck \
        unzip \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && groupadd --gid "${WORKER_GID}" protomolt \
    && useradd --uid "${WORKER_UID}" --gid "${WORKER_GID}" \
        --create-home --home-dir /home/protomolt --shell /bin/bash protomolt \
    && install -d -o protomolt -g protomolt /workspace /state /opt/sdkman /opt/protomolt-tools/bin \
    && chmod 755 /home/protomolt

COPY build/install/protomolt-agent-host /opt/protomolt-agent-host

RUN chmod -R a+rX /opt/protomolt-agent-host \
    && ln -s /opt/protomolt-agent-host/bin/protomolt-agent-host /usr/local/bin/protomolt-agent-host \
    && ln -s /usr/local/bin/bun /usr/local/bin/bunx

ENV HOME=/home/protomolt \
    CONAN_HOME=/workspace/.conan2 \
    GRADLE_USER_HOME=/workspace/.gradle-user-home \
    UV_CACHE_DIR=/workspace/.cache/uv \
    UV_TOOL_BIN_DIR=/opt/protomolt-tools/bin \
    XDG_CACHE_HOME=/workspace/.cache \
    PATH=/opt/protomolt-tools/bin:/home/protomolt/.kimi-code/bin:/usr/local/bin:/opt/protomolt-agent-host/bin:${PATH}

USER protomolt
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/protomolt-agent-host"]
CMD ["--help"]

FROM common AS java

ARG JAVA_21_VERSION=21.0.12-tem
ARG JAVA_25_VERSION=25.0.4-tem
ARG JAVA_26_VERSION=26.0.2-tem
ARG GRAALVM_VERSION=25.2.4-graalce
ARG GRADLE_VERSION=9.6.1
ARG MAVEN_VERSION=3.9.16
ARG GRPC_JAVA_VERSION=1.83.1
ARG TARGETARCH

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

USER protomolt
ENV SDKMAN_DIR=/opt/sdkman
SHELL ["/bin/bash", "-lc"]
RUN curl -fsSL https://get.sdkman.io | bash \
    && source "${SDKMAN_DIR}/bin/sdkman-init.sh" \
    && sdk install java "${JAVA_21_VERSION}" \
    && sdk install java "${JAVA_25_VERSION}" \
    && sdk install java "${JAVA_26_VERSION}" \
    && sdk install java "${GRAALVM_VERSION}" \
    && sdk default java "${JAVA_25_VERSION}" \
    && sdk install gradle "${GRADLE_VERSION}" \
    && sdk install maven "${MAVEN_VERSION}" \
    && sdk flush archives \
    && sdk flush temp

USER root
RUN case "${TARGETARCH}" in \
        amd64) grpc_arch=x86_64 ;; \
        arm64) grpc_arch=aarch_64 ;; \
        *) printf 'unsupported architecture: %s\n' "${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && grpc_java_url="https://repo1.maven.org/maven2/io/grpc/protoc-gen-grpc-java/${GRPC_JAVA_VERSION}/protoc-gen-grpc-java-${GRPC_JAVA_VERSION}-linux-${grpc_arch}.exe" \
    && curl -fsSL "${grpc_java_url}" -o /usr/local/bin/protoc-gen-grpc-java \
    && curl -fsSL "${grpc_java_url}.sha256" -o /tmp/protoc-gen-grpc-java.sha256 \
    && printf '%s  %s\n' "$(cat /tmp/protoc-gen-grpc-java.sha256)" /usr/local/bin/protoc-gen-grpc-java | sha256sum -c - \
    && chmod 755 /usr/local/bin/protoc-gen-grpc-java \
    && rm /tmp/protoc-gen-grpc-java.sha256 \
    && ln -s /opt/sdkman/candidates/java/25.2.4-graalce/bin/native-image /usr/local/bin/native-image \
    && chmod -R a+rwX /opt/sdkman

# AgentHost is compiled with --release 25 (class file 69). The Gradle start
# script honors JAVA_HOME, which follows sdkman's `current` symlink, so the
# default must stay on Temurin 25. JDK 21, 26, and GraalVM remain installed.
ENV JAVA_HOME=/opt/sdkman/candidates/java/current \
    GRAALVM_HOME=/opt/sdkman/candidates/java/25.2.4-graalce \
    PATH=/opt/sdkman/candidates/java/current/bin:/opt/sdkman/candidates/gradle/current/bin:/opt/sdkman/candidates/maven/current/bin:${PATH}

USER protomolt

FROM common AS cpp

ARG CONAN_VERSION=2.31.2

COPY --from=jre /opt/java/openjdk /opt/java/openjdk

ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:${PATH}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ccache \
        clang \
        clang-format \
        clang-tidy \
        cmake \
        gdb \
        libgrpc++-dev \
        libprotobuf-dev \
        libtool \
        lldb \
        ninja-build \
        pkg-config \
        protobuf-compiler-grpc \
    && rm -rf /var/lib/apt/lists/*

USER protomolt
RUN uv tool install "conan==${CONAN_VERSION}"
