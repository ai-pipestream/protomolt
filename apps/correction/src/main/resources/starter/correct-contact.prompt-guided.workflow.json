{
  "name": "correct-contact",
  "schema": {"type": "ai.protomolt.proto.correction.v1.RawContact"},
  "inputType": "ai.protomolt.proto.correction.v1.RawContact",
  "deadlineMs": 300000,
  "steps": [{
    "name": "correct",
    "structured": {
      "targetType": "ai.protomolt.proto.correction.v1.CorrectedContact",
      "model": "starter-correction",
      "maxAttempts": 3,
      "mode": "STRUCTURED_GENERATION_MODE_PROMPT_GUIDED"
    },
    "edge": {
      "sources": ["input"],
      "produceType": "ai.protomolt.proto.correction.v1.RawContact",
      "rules": ["record_id = input.record_id", "contact_text = input.contact_text", "internal_notes = input.internal_notes"],
      "projectTo": "ai.protomolt.proto.correction.v1.ContactGrounding",
      "validate": true
    }
  }]
}
