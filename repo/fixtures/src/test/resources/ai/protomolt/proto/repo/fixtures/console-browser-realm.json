{
  "realm": "protomolt",
  "enabled": true,
  "sslRequired": "none",
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@example.com",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Lyst",
      "credentials": [
        {
          "type": "password",
          "value": "analyst-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "protomolt-console",
      "enabled": true,
      "publicClient": false,
      "secret": "console-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${CALLBACK}"
      ],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "protomolt scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "protomolt_scopes",
            "claim.value": "search-query",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
