.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Local secrets for the Krick agent-host stack (never commit tokens)
deploy/krick/.env

# Python bytecode caches (scripts/ has stdlib-only utilities and their unittest files)
__pycache__/
*.pyc

# Skills are tracked; the rest of .claude/ (worktrees, local settings) stays ignored
# by the global ignore file.
!.claude/skills/
